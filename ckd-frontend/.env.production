# Production environment.
#
# Same rule as .env.development, and it matters more here: every value below ships
# to the browser. No secret, token, key, or password may ever appear in a VITE_*
# variable (architecture §8.1).

# Still relative (ADR-9). The deployment must front the static bundle with a
# reverse proxy that maps /api/* to the FastAPI service and strips the /api
# prefix — the same contract the Vite dev proxy implements. Keeping the path
# relative means the production build contains no backend hostname, and the API
# needs no CORS allowance for the site's origin.
VITE_API_BASE_URL=/api

VITE_API_TIMEOUT=30000

# Less aggressive than development: a deployed API is not being restarted while
# someone is filling in an assessment.
VITE_HEALTH_CHECK_INTERVAL=120000
