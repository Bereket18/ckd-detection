# Development environment template.
# Copy to .env.development (gitignored) and adjust as needed.
#
# SECURITY: Every VITE_* variable is inlined into the JS bundle at build time
# and is readable by any browser. No secret, token, key, or password may ever
# appear here (FRONTEND_PLAN.md Rule 9, architecture §8.1).

# Relative on purpose (ADR-9). Requests go to :5173/api/* and the Vite proxy
# forwards them to FastAPI on :8000, so the browser makes a same-origin request
# and CORS is never exercised in development.
VITE_API_BASE_URL=/api

# Client-side ceiling on a single request. The backend has no timeout of its own.
VITE_API_TIMEOUT=30000

# How often /health is re-probed while a tab is visible.
VITE_HEALTH_CHECK_INTERVAL=60000
