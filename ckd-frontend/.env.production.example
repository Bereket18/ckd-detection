# Production environment template.
# Copy to .env.production (gitignored) before building for deployment.
#
# SECURITY: Every VITE_* variable ships to the browser. No secret, token,
# key, or password may ever appear here (FRONTEND_PLAN.md Rule 9).

# Still relative (ADR-9). The deployment must front the static bundle with
# a reverse proxy that maps /api/* → FastAPI and strips the /api prefix.
# Keeping the path relative means the bundle contains no backend hostname
# and the API needs no CORS allowance for the site's origin.
VITE_API_BASE_URL=/api

VITE_API_TIMEOUT=30000

# Less aggressive than development — a deployed API is not being restarted
# while someone is filling in an assessment.
VITE_HEALTH_CHECK_INTERVAL=120000
